{
  "name": "__PROJECT_NAME__-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "openapi": "bun run src/openapi.ts --write",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "croner": "^10.0.1",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/bun": "^1.4.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.0.0",
    "eslint-plugin-import-x": "^4.17.1",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0"
  }
}
