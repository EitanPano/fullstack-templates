# Copy the values you need into your shell environment or a secret manager. Never create a
# real env file in the working tree; never commit one. Every variable the app
# reads is listed here with a placeholder and parsed in src/app/config/env.py, nowhere else.

# development, test or production.
APP_ENV=development
# Port the API listens on.
PORT=8000
# Proxy trust: true, false, a hop count (1 behind one reverse proxy), or a comma list of
# addresses, subnets and the presets loopback, linklocal and uniquelocal.
TRUST_PROXY=false
# Comma-separated browser origins allowed by CORS. Leave unset to disable CORS (no browser calls the API from another origin).
CORS_ORIGINS=
# Directory of a built single-page app to serve after the API (the single image sets it). Unset serves none.
STATIC_DIR=
# @auth-start
# Signs access tokens. Required in production, at least 32 characters; a fake default applies elsewhere.
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# Signs refresh tokens. Required in production, at least 32 characters, different from the access secret.
JWT_REFRESH_SECRET=change-me-to-a-different-random-string-of-32-chars-or-more
# Keys the one-time-code hash. Required in production, at least 32 characters.
OTP_SECRET=change-me-to-another-random-string-of-at-least-32-chars
# @auth-end
# Base64 of 32 random bytes, encrypts stored secrets. Required in production.
ENCRYPTION_KEY=change-me-base64-of-32-random-bytes
# @auth-start
# Cookie domain for auth cookies. Optional; unset keeps them host-only.
COOKIE_DOMAIN=
# @auth-end
# Mail provider: console (prints in development) or a registered provider name.
MAIL_PROVIDER=console
# SMS provider: console or a registered provider name.
SMS_PROVIDER=console
# WhatsApp provider: console or a registered provider name.
WHATSAPP_PROVIDER=console
# Sender address. Required when MAIL_PROVIDER is not console.
MAIL_FROM=no-reply@example.com
# Run the scheduled jobs in this process: true or false.
JOBS_ENABLED=true
# Multiplies every rate limit (1 to 1000). Production keeps 1; an e2e run raises it so a journey suite
# is not limited. There is no switch that turns limiting off.
RATE_LIMIT_SCALE=1
