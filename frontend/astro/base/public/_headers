# Static headers for a static host. Cloudflare Pages reads this file; other hosts use their own. The
# Content-Security-Policy is not here: Astro writes it as a <meta> on every page (its hashes change
# every build); beside serverless/cloudflare its assemble step adds one fixed header (frame-ancestors
# and the directives a meta cannot carry), and a _headers file may not set or detach it.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
