---
// field.astro belongs: a label, an optional hint, the control (the default slot) and its error
// region. The region is always rendered, because a live region must exist before its text, and
// `services/forms.ts` writes the field errors into `[data-field-error]`. The control carries the
// same `id` (input.astro wires aria-describedby from it).
// It does not belong: the control itself (input.astro) or when an error shows (the form script).
import './field.scss'

type Props = { id: string; label: string; hint?: string; error?: string }

const { id, label, hint, error } = Astro.props
---

<div class:list={['field', { 'field--invalid': Boolean(error) }]} data-field>
  <label class="field__label" for={id}>
    {label}
  </label>
  {hint && (
    <p class="field__hint" id={`${id}-hint`}>
      {hint}
    </p>
  )}
  <slot />
  <div class="field__error" id={`${id}-error`} data-field-error aria-live="polite">
    {error}
  </div>
</div>
