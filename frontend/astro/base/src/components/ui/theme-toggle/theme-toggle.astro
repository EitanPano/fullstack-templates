---
// theme-toggle.astro belongs: the theme switch. One icon button cycles light, dark and system and
// is named by the current and the next choice; a polite status line announces the active one. The
// base layout does not show it: a product places it where it wants (a header, a menu).
// It does not belong: the theme logic (services/theme.ts) or the script (theme-toggle.ts).
import Button from '../button/button.astro'
import './theme-toggle.scss'
---

<span class="theme-toggle" data-theme-toggle>
  <Button variant="ghost" size="icon" aria-label="Theme" data-theme-toggle-button>
    <svg
      class="theme-toggle__icon theme-toggle__icon--light"
      viewBox="0 0 24 24"
      width="20"
      height="20"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </svg>
    <svg
      class="theme-toggle__icon theme-toggle__icon--dark"
      viewBox="0 0 24 24"
      width="20"
      height="20"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
    </svg>
    <svg
      class="theme-toggle__icon theme-toggle__icon--system"
      viewBox="0 0 24 24"
      width="20"
      height="20"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="2" y="3" width="20" height="14" rx="2"></rect>
      <path d="M8 21h8M12 17v4"></path>
    </svg>
  </Button>
  <span class="visually-hidden" role="status" data-theme-toggle-status></span>
</span>

<script>
  import { initThemeToggle } from './theme-toggle'

  initThemeToggle()
</script>
