---
// skeleton.astro belongs: a placeholder shaped like the content it stands for: a block (sized sm,
// md or lg) or `lines` lines of text. It is hidden from assistive technology; the region that
// loads says it is busy (aria-busy). It does not belong: the loading logic (the page's script).
import './skeleton.scss'

type Props = { variant?: 'block' | 'text'; size?: 'sm' | 'md' | 'lg'; lines?: number }

const { variant = 'text', size = 'md', lines = 3 } = Astro.props
const count = variant === 'text' ? Math.max(1, lines) : 1
const itemClass = variant === 'block' ? `skeleton__item skeleton__item--${size}` : 'skeleton__item'
---

<div class:list={['skeleton', { 'skeleton--text': variant === 'text' }]} aria-hidden="true">
  {Array.from({ length: count }, () => (
    <div class={itemClass} />
  ))}
</div>
