---
// spinner.astro belongs: a busy indicator. Alone it is a status region with a label; inside a
// control that already says it is busy (the button) it is `decorative` and silent.
// It does not belong: deciding when to show (the page's script toggles `hidden`).
import { UI_COPY } from '../../../models/ui/constant'
import './spinner.scss'

type Props = { label?: string; decorative?: boolean }

const { label = UI_COPY.loading, decorative = false } = Astro.props
---

{decorative ? (
  <span class="spinner" aria-hidden="true">
    <span class="spinner__ring" />
  </span>
) : (
  <span class="spinner" role="status">
    <span class="spinner__ring" aria-hidden="true" />
    <span class="visually-hidden">{label}</span>
  </span>
)}
