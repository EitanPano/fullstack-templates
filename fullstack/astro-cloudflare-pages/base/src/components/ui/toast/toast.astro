---
// toast.astro belongs: the region toasts appear in. A product places it once, in the layout, after
// <main>; `showToast` in toast.ts adds a toast to it. The region is a polite live region, and an
// error toast inside it is announced assertively.
// It does not belong: a toast's content (the caller words it from the copy tables).
import { UI_COPY } from '../../../models/ui/constant'
import '../button/button.scss'
import './toast.scss'
---

<div
  class="toast-region"
  data-toast-region
  role="region"
  aria-live="polite"
  aria-label={UI_COPY.notifications}
></div>
