{
  "name": "__PROJECT_NAME__",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build && node scripts/csp-headers.mjs",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "db:generate": "drizzle-kit generate",
    "dev": "node scripts/dev.mjs",
    "e2e:db": "node scripts/e2e-db.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "migrate": "wrangler d1 migrations apply DB --local",
    "start": "node scripts/start.mjs",
    "test": "vitest run",
    "test:db": "vitest run --project api",
    "test:e2e": "bun run build && playwright test",
    "typecheck": "wrangler types --check && astro check && tsc -p tsconfig.server.json --noEmit && tsc -p tests/tsconfig.json --noEmit && tsc -p tests/e2e/tsconfig.json --noEmit",
    "types": "wrangler types"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "drizzle-orm": "0.45.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vitest-plugin": "1.8.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "astro": "7.4.12",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-import-x": "^4.18.1",
    "jsdom": "^31",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "sass-embedded": "^1.108.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "4.1.12",
    "wrangler": "4.163.0"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.0.0"
  }
}
