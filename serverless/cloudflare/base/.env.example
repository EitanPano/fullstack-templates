# Local overrides for `wrangler dev`: copy this file to a file named `.env` (never commit
# it). Do not create a `.dev.vars` beside it: where that file exists, `.env` is ignored whole.
# Production secrets are set by a person in the Cloudflare dashboard, never in a file.
#
# Plain variables (ENVIRONMENT) live in wrangler.jsonc; a value here overrides it for local runs.
# @frontends-start

# The host of each frontend: `host=dir` pairs, comma-separated, hosts without a port, each frontend
# at least once. Required in every environment. A browser resolves *.localhost by itself.
FRONTEND_HOSTS=__FRONTEND_HOSTS__
# @frontends-end

# Not needed until a feature encrypts something at rest (nothing in the template does). Then set
# it in every environment: base64 of 32 random bytes, made with `openssl rand -base64 32`. A value
# that is set must be valid; there is no default.
# ENCRYPTION_KEY=
# Multiplies every rate limit (1 to 1000). Production keeps 1; `bun run start` takes it from the
# shell for an e2e run. There is no switch that turns limiting off.
RATE_LIMIT_SCALE=1
# debug, info, warn or error.
LOG_LEVEL=info
# @sdk-start
# The SDK's publishable keys and the origins each may be used from: `key=origin,origin;key=origin`.
# A key identifies an integration and grants nothing alone. Unset or empty refuses every
# /api/sdk/v1 request. A deployed Worker takes it from `vars` in wrangler.jsonc, per environment.
# Production takes https origins of a real host only: an http or loopback origin is refused there.
SDK_KEYS=pk_dev=http://localhost:__SDK_PORT__
# What GET /api/sdk/v1/config answers: true (the default) or false, the kill switch.
SDK_ENABLED=true
# Origins the frame may load images from, comma-separated, in the closed form a key origin has.
# Empty: the frame loads only its own. Production refuses an http or loopback origin here too.
SDK_IMG_ORIGINS=
# @sdk-end
