# Local overrides for `wrangler pages dev`: copy this file to a file named `.env` (never commit
# it). Do not create a `.dev.vars` beside it: where that file exists, `.env` is ignored whole.
# Production secrets are set by a person in the Cloudflare dashboard, never in a file.
#
# Plain variables (ENVIRONMENT) live in wrangler.jsonc; a value here overrides it for local runs.

# Base64 of 32 random bytes, encrypts stored secrets. Required in production; a plainly fake
# default applies elsewhere.
ENCRYPTION_KEY=change-me-base64-of-32-random-bytes
# Multiplies every rate limit (1 to 1000). Production keeps 1; `bun run start` takes it from the
# shell for an e2e run. There is no switch that turns limiting off.
RATE_LIMIT_SCALE=1
# debug, info, warn or error.
LOG_LEVEL=info
