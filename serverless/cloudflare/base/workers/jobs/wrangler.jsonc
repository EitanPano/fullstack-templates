// The jobs Worker: a second deployment beside the Pages project, with its own name. It reads the
// same D1 databases (a Worker's environments, like Pages', do not inherit bindings, so each
// restates them; tests/unit/jobs-config.test.ts asserts they match ../../wrangler.jsonc). One cron
// trigger runs the one job. No secret belongs in this file. Run it locally with
//   wrangler dev --config workers/jobs/wrangler.jsonc --test-scheduled
{
  "name": "__PROJECT_NAME__-jobs",
  "main": "index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["17 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "__PROJECT_NAME__-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations",
    },
  ],
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "__PROJECT_NAME__-preview",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "../../migrations",
        },
      ],
    },
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "__PROJECT_NAME__-production",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "../../migrations",
        },
      ],
    },
  },
}
