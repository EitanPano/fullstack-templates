{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EitanPano/fullstack-templates/schemas/cases.schema.json",
  "title": "Generation cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "stack": { "type": "string", "minLength": 1 },
          "flags": { "type": "object", "additionalProperties": { "type": "boolean" } },
          "capabilities": { "type": "object", "additionalProperties": { "type": "string" } },
          "withApp": { "type": "boolean" }
        }
      }
    }
  }
}
