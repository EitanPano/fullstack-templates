{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EitanPano/fullstack-templates/schemas/cases.schema.json",
  "title": "Generation cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "stack": { "type": "string", "minLength": 1 },
          "frontends": {
            "type": "array",
            "description": "A stack case only: the frontends of the plan as <dir>=<template> pairs, in order, in place of the stack's frontend member (generate --frontend). The first takes the case's own flags and capabilities.",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)?=[a-z]+/[a-z][a-z0-9-]*$"
            }
          },
          "sdk": {
            "type": "string",
            "description": "A stack case of another template: the sdk package of the plan as <dir>=<template> (generate --sdk).",
            "pattern": "^[a-z][a-z0-9-]*=sdk/[a-z][a-z0-9-]*$"
          },
          "packages": {
            "type": "object",
            "description": "Flags and capabilities of further packages of the plan, by directory (an answers file's packages).",
            "propertyNames": { "pattern": "^[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)?$" },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "flags": { "type": "object", "additionalProperties": { "type": "boolean" } },
                "capabilities": { "type": "object", "additionalProperties": { "type": "string" } }
              }
            }
          },
          "flags": { "type": "object", "additionalProperties": { "type": "boolean" } },
          "capabilities": { "type": "object", "additionalProperties": { "type": "string" } },
          "withApp": { "type": "boolean" },
          "deploy": { "enum": ["single", "split"] },
          "brand": {
            "type": "object",
            "description": "A frontend case only: the brand inputs, as answers.brand takes them.",
            "additionalProperties": false,
            "properties": {
              "displayName": { "type": "string", "minLength": 1, "maxLength": 60 },
              "primary": { "type": "string", "pattern": "^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$" },
              "neutral": { "type": "string", "pattern": "^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$" },
              "radius": { "enum": ["sm", "md", "lg"] },
              "font": { "enum": ["system", "inter"] },
              "theme": { "enum": ["system", "light", "dark"] },
              "density": { "enum": ["comfortable", "compact"] }
            }
          },
          "server": {
            "type": "object",
            "description": "A frontend case only: the flags and capabilities of the stack's server package.",
            "additionalProperties": false,
            "properties": {
              "flags": { "type": "object", "additionalProperties": { "type": "boolean" } },
              "capabilities": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
