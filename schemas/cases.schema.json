{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EitanPano/fullstack-templates/schemas/cases.schema.json",
  "title": "Generation cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "stack": { "type": "string", "minLength": 1 },
          "flags": { "type": "object", "additionalProperties": { "type": "boolean" } },
          "capabilities": { "type": "object", "additionalProperties": { "type": "string" } },
          "withApp": { "type": "boolean" },
          "deploy": { "enum": ["single", "split"] },
          "brand": {
            "type": "object",
            "description": "A frontend case only: the brand inputs, as answers.brand takes them.",
            "additionalProperties": false,
            "properties": {
              "displayName": { "type": "string", "minLength": 1, "maxLength": 60 },
              "primary": { "type": "string", "pattern": "^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$" },
              "neutral": { "type": "string", "pattern": "^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$" },
              "radius": { "enum": ["sm", "md", "lg"] },
              "font": { "enum": ["system", "inter"] },
              "theme": { "enum": ["system", "light", "dark"] },
              "density": { "enum": ["comfortable", "compact"] }
            }
          },
          "server": {
            "type": "object",
            "description": "A frontend case only: the flags and capabilities of the stack's server package.",
            "additionalProperties": false,
            "properties": {
              "flags": { "type": "object", "additionalProperties": { "type": "boolean" } },
              "capabilities": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
