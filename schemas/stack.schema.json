{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EitanPano/fullstack-templates/schemas/stack.schema.json",
  "title": "Stack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "summary", "packages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "summary": { "type": "string", "pattern": "^[^\\n]+$" },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["template", "dir"],
        "properties": {
          "template": { "type": "string", "minLength": 1 },
          "dir": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        }
      }
    }
  }
}
