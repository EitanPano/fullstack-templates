{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EitanPano/fullstack-templates/schemas/capability.schema.json",
  "title": "Capability manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "provider", "summary"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "enum": ["database", "cache", "messaging"]
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "summary": {
      "type": "string",
      "pattern": "^[^\\r\\n]+$"
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "remove": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "add": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dependencies": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "devDependencies": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "scripts": {
      "type": "object",
      "description": "Lines for the package manifest's scripts; unlike a command they may use ./ and shell syntax because the package manager runs them.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9:_-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "container": {
      "type": "object",
      "description": "What the generated container runs for this capability.",
      "additionalProperties": false,
      "required": ["migrate"],
      "properties": {
        "migrate": { "$ref": "#/$defs/command" }
      }
    },
    "pins": {
      "type": "object",
      "description": "A base file the overlay replaces, relative to base/, mapped to the git blob id (40 hex) it was reconciled against.",
      "propertyNames": { "$ref": "#/$defs/relativePath" },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{40}$"
      }
    },
    "flags": {
      "type": "object",
      "description": "Per template flag: overlay files that exist only while the flag is on.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["onlyPaths"],
        "properties": {
          "onlyPaths": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/relativePath"
            }
          }
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install": { "$ref": "#/$defs/command" },
        "dev": { "$ref": "#/$defs/command" },
        "check": { "$ref": "#/$defs/command" },
        "typecheck": { "$ref": "#/$defs/command" },
        "lint": { "$ref": "#/$defs/command" },
        "format": { "$ref": "#/$defs/command" },
        "test": { "$ref": "#/$defs/command" },
        "start": { "$ref": "#/$defs/command" },
        "testDb": { "$ref": "#/$defs/command" },
        "testE2e": { "$ref": "#/$defs/command" },
        "e2eDb": { "$ref": "#/$defs/command" },
        "contract": { "$ref": "#/$defs/command" },
        "migrate": { "$ref": "#/$defs/command" }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "description": "A POSIX relative path inside the overlay: segments of letters, digits, dot, underscore, at, parentheses (a route group) and hyphen joined by '/'; no segment holding '..', no leading '/', no drive letter, no backslash.",
      "pattern": "^(?!(.*/)?[().]*\\.\\.[().]*(/|$))[A-Za-z0-9._@()-]+(/[A-Za-z0-9._@()-]+)*$"
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "description": "A program plus whitespace-separated arguments, run without a shell: no pipes, redirects, quoting, variables or command substitution.",
      "pattern": "^[^&|;<>'\"$`]+$"
    }
  }
}
