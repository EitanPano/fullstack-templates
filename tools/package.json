{
  "name": "fullstack-templates-tools",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.3",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6",
    "typescript-eslint": "^8.72.0"
  }
}
